# Secret de session (obligatoire). Génère-le avec : npx auth secret
AUTH_SECRET=

# Connexion Google (obligatoire pour « Mes codes »).
# Console Google Cloud > Identifiants > ID client OAuth > Application Web.
# URI de redirection autorisée : http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Paiement Mobile Money via GeniusPay (Wave, Orange Money, MTN Money).
# Clés sur https://pay.genius.ci : pk_sandbox_/pk_live_ et sk_sandbox_/sk_live_.
# Sans ces deux clés, un pilote de démonstration prend le relais : le parcours
# complet fonctionne, aucun montant n'est réellement débité.
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=

# Secret de signature des webhooks GeniusPay. Sans lui, les notifications
# entrantes sont refusées : c'est voulu, une notification non signée ne prouve rien.
GENIUSPAY_WEBHOOK_SECRET=

# Domaine public utilisé par les liens courts trame.ci/r/{id}.
# En production : https://trame.ci
APP_URL=http://localhost:3000

# Compte propriétaire : génération illimitée et sans paiement.
# Tous les autres comptes reçoivent leur premier code offert, puis paient 2 000 F.
OWNER_EMAIL=
